# ==============================================================================
# ReviewBot Configuration
# ==============================================================================

# Server settings
HOST=0.0.0.0
PORT=8000
DEBUG=false

# GitHub Webhook Secret (configured in GitHub Repo / App Webhook settings)
# Required for validating X-Hub-Signature-256 header
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# ------------------------------------------------------------------------------
# GitHub Authentication (Option 1: Personal Access Token - for quick dev/testing)
# ------------------------------------------------------------------------------
# Needs repo permissions (read contents, write pull requests)
GITHUB_TOKEN=ghp_your_personal_access_token

# ------------------------------------------------------------------------------
# GitHub Authentication (Option 2: GitHub App - for multi-repo production)
# ------------------------------------------------------------------------------
# GITHUB_APP_ID=123456
# GITHUB_APP_PRIVATE_KEY_PATH=path/to/private-key.pem
# # Or provide PEM content directly:
# # GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n..."
# GITHUB_APP_INSTALLATION_ID=7891011

# ------------------------------------------------------------------------------
# Google Gemini API Configuration
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
MAX_TOKENS_PER_FILE=4000
MAX_RESPONSE_TOKENS=4096

# ------------------------------------------------------------------------------
# Review Bot Behaviors, Concurrency & Cost Guardrails
# ------------------------------------------------------------------------------
# Severity threshold to post inline comments: INFO, LOW, MEDIUM, HIGH, CRITICAL
# If set to MEDIUM, INFO and LOW findings will be omitted from inline comments
SEVERITY_THRESHOLD=MEDIUM

# Automatically post approval if no issues found (APPROVE / COMMENT / REQUEST_CHANGES)
AUTO_APPROVE_CLEAN_PR=true

# Files and extensions to automatically ignore during review
IGNORE_EXTENSIONS=.lock,.min.js,.min.css,.map,.svg,.png,.jpg,.jpeg,.gif,.ico,.woff,.woff2,.ttf,.eot
IGNORE_FILES=package-lock.json,yarn.lock,pnpm-lock.yaml,poetry.lock,Cargo.lock,Pipfile.lock,composer.lock
MAX_FILE_SIZE_BYTES=100000

# Cost guardrails & concurrency
MAX_FILES_PER_REVIEW=30
MAX_DIFF_SIZE_BYTES=500000
REVIEW_CONCURRENCY_LIMIT=5
